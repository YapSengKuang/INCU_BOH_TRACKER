{
  "name": "boh-stock-finder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-boh --only firestore \"vitest run --config vitest.firebase.config.ts\"",
    "test:all": "npm test && npm run test:rules",
    "emulators": "firebase emulators:start --project demo-boh --only auth,firestore",
    "firebase:admin": "node scripts/firebase-admin.ts"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@firebase/firestore": { "@grpc/grpc-js": "1.14.6" },
    "re2": "1.27.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
